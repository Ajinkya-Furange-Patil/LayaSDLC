# LayaSDLC configuration template
# ---------------------------------------------------------------------------------------
# Copy to `.env` and edit. `.env` is git-ignored; this file is not and must never
# contain a real credential, token, password or private endpoint detail.
#
#   cp .env.example .env
#
# Every value below is a placeholder. The service reads these through the
# environment, so nothing here is loaded automatically by Python itself.

# --- inference endpoint -----------------------------------------------------------------
# The default is a *public, keyless* endpoint verified live during development.
# Its /health reports `collecting_data: true` -- never send secrets or private
# customer data through it.
LAYA_BASE_URL=https://laya.inference.zaitlabs.com

# Optional bearer token. Leave empty for the default public endpoint.
# NEVER commit a filled-in value; `.env` is ignored, `.env.example` is not.
LAYA_API_KEY=

# Optional model hint. Accepted values verified against the endpoint:
#   laya
#   laya/english | laya/multilingual | laya/typed-decisions | laya/watt-flash-0.1
#   typesafe/jev
# NOTE: `laya-english` is NOT accepted -- it returns HTTP 400 unknown_model.
# Leave empty to accept the server's default.
LAYA_MODEL=

# --- engine selection -------------------------------------------------------------------
#   http -> LayaHttpEngine   POST /v1/systemone   (default, the only verified path)
#   sdk  -> LayaSdkEngine    local `laya` package (requires the package to be installed)
LAYA_ENGINE=http

# --- timeouts ---------------------------------------------------------------------------
# Seconds to wait for the live health probe before integration tests skip.
# The controller's own per-decision timeout is set in code (ControllerConfig).
LAYA_PROBE_TIMEOUT=10
